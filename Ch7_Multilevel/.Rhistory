values = c("solid", "dashed"),
name   = "Drug",                       # <- match A exactly
labels = c("Placebo", "Medication")    # <- match A exactly
) +
coord_cartesian(ylim = c(3, 7)) +        # <- same limits as A
labs(title = NULL, subtitle = NULL) +
