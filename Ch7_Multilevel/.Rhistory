fig7_7b$layers[[i]]$mapping[["linetype"]] <- q
}
# make the two CI ribbons a bit more visible
for (i in which(vapply(fig7_7b$layers,
function(l) inherits(l$geom, "GeomRibbon"), logical(1)))) {
fig7_7b$layers[[i]]$aes_params$alpha <- 0.35
}
