# VAR(1) DSEM WITH CARRYOVER AND SPILLOVER
# plotting functions
# source('https://raw.githubusercontent.com/blimp-stats/blimp-book/main/misc/functions.R')
source("/Users/craig/Dropbox/Claude/Projects/Blimp Book/rblimp_cleaned_functions.R")
#------------------------------------------------------------------------------#
# LOAD R PACKAGES ----
#------------------------------------------------------------------------------#
library(ggplot2)
library(rblimp)
set_blimp('/applications/blimp/blimp-nightly')
#------------------------------------------------------------------------------#
# READ DATA ----
#------------------------------------------------------------------------------#
# github url for raw data
data_url <- 'https://raw.githubusercontent.com/blimp-stats/blimp-book/main/data/diary.csv'
# create data frame from github data
diary <- read.csv(data_url)
mod <- rblimp(
data = diary,                                  # R data frame
clusterid = 'person',                          # cluster-level identifier
timeid = 'day',                                # occasion-level identifer
latent = 'person = b0c b1c b2c a0c a1c a2c lnvar_pain lnvar_paff',   # define latent variables
model = '
level2:                                      # model block label
intercept female painaccept catastrophize stress -> b0c b1c b2c a0c a1c a2c lnvar_pain lnvar_paff; # latent variable means
b0c b1c b2c a0c a1c a2c lnvar_pain lnvar_paff ~~ b0c b1c b2c a0c a1c a2c lnvar_pain lnvar_paff;  # random effect correlations
level1:                                      # model block label
lag_posaff = posaff.lag - b0c;               # definition variable
lag_pain = pain.lag - a0c;                   # definition variable
sleep_w = sleep - c0c;
pain ~   intercept@a0c lag_pain@a1c lag_posaff@a2c sleep_w@a3c;  # level-1 model
var(pain) ~ intercept@lnvar_pain;            # level-1 model
posaff ~ intercept@b0c lag_posaff@b1c lag_pain@b2c sleep_w@b3c;  # level-1 model
var(posaff) ~ intercept@lnvar_paff;          # level-1 model
sleep ~  intercept@c0c;
posaff ~~ pain;',                            # level-1 residual correlation
seed = 90291,                                  # random number seed
burn = 20000,                                  # warm-up iterations
iter = 20000                                   # analysis iterations
)
DiaryPain <- mod@average_imp[,1:9]
View(DiaryPain)
DiaryPain$posaff <- round(DiaryPain$posaff * 4) / 4
DiaryPain$posaff <- round(DiaryPain$posaff * 4) / 4
DiaryPain$pain <- round(DiaryPain$pain,0)
DiaryPain$sleep <- round(DiaryPain$sleep,0)
DiaryPain <- mod@average_imp[,1:9]
DiaryPain$posaff <- round(DiaryPain$posaff * 4) / 4
DiaryPain$pain <- round(DiaryPain$pain,0)
DiaryPain$sleep <- round(DiaryPain$sleep,0)
DiaryPain <- mod@average_imp[,1:9]
DiaryPain$posaff <- round(DiaryPain$posaff * 4) / 4
DiaryPain$pain <- round(DiaryPain$pain,0)
DiaryPain$sleep <- round(DiaryPain$sleep,0)
summarytools::dfSummary(DiaryPain)
DiaryPain$catastrophize <- round(DiaryPain$catastrophize,2)
View(DiaryPain)
DiaryPain <- mod@average_imp[,1:10]
DiaryPain <- mod@average_imp[,1:9]
DiaryPain <- mod@average_imp[,1:9]
DiaryPain$posaff <- round(DiaryPain$posaff * 4) / 4
DiaryPain$pain <- round(DiaryPain$pain,0)
DiaryPain$sleep <- round(DiaryPain$sleep,0)
DiaryPain$painaccept <- round(DiaryPain$painaccept,2)
DiaryPain$catastrophize <- round(DiaryPain$catastrophize,2)
DiaryPain$stress <- round(DiaryPain$stress,2)
View(DiaryPain)
output(mod)
write.csv(DiaryPain, file = '~/desktop/DiaryPain.csv', row.names = F)
