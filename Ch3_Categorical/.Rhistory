#------------------------------------------------------------------------------#
library(ggplot2)
library(rblimp)
set_blimp('/applications/blimp/blimp-nightly')
#------------------------------------------------------------------------------#
# READ DATA ----
#------------------------------------------------------------------------------#
# github url for raw data
data_url <- 'https://raw.githubusercontent.com/blimp-stats/blimp-book/main/data/alcohol.csv'
# create data frame from github data
alcohol <- read.csv(data_url)
summary(alcohol)
mod1 <- rblimp(
data = alcohol,                                # R data frame
ordinal = 'college male',                      # binary and ordinal variables
nominal = 'drinkfreq',                         # nominal variables (auto dummy coded)
count = 'cigdays alcdays',
center = 'agetryalc age',                      # center predictors
model = '
# drinkfreq ~ agetryalc agetrycig college age male;
cigdays ~ agetryalc agetrycig college age male;
alcdays ~ agetryalc agetrycig college age male;
',  # regression model
seed = 90291,                                  # random number seed
burn = 10000,                                  # warm-up iterations
iter = 10000)
ctable(
alcohol$drinker,
alcohol$drinkfreq
)
table(alcohol$drinker, alcohol$drinkfreq)
output(mod1)                                     # print output
hist(alcohol$agetryalc)
mod1 <- rblimp(
data = alcohol,                                # R data frame
ordinal = 'college male',                      # binary and ordinal variables
# nominal = 'drinkfreq',                         # nominal variables (auto dummy coded)
count = 'cigdays alcdays',
center = 'age',                      # center predictors
model = '
# drinkfreq ~ agetryalc agetrycig college age male;
cigdays ~ agetryalc agetrycig college age male;
alcdays ~ agetryalc agetrycig college age male;
college age male ~ agetryalc agetrycig;
yjt(agetryalc) ~ (agetrycig - 10);
yjt(agetrycig) ~ 1;
',  # regression model
seed = 90291,                                  # random number seed
burn = 10000,                                  # warm-up iterations
iter = 10000)                                  # analysis iterations
output(mod1)
alcoholuse_new <- mod1@average_imp
alcoholuse_new <- mod1@average_imp[,1:8]
alcoholuse_new$drinkingfreq <-
with(alcoholuse_new,
ifelse(is.na(alcdays), NA_integer_,
ifelse(alcdays == 0, 0L,
ifelse(alcdays <= 7, 1L, 2L))))
)
alcoholuse_new$drinkingfreq <-
with(alcoholuse_new,
ifelse(is.na(alcdays), NA_integer_,
ifelse(alcdays == 0, 0L,
ifelse(alcdays <= 7, 1L, 2L))))
summarytools::freq(alcoholuse_new$drinkingfreq)
alcoholuse_new <- mod1@average_imp[,1:8]
alcoholuse_new$drinker <-
with(
alcoholuse_new,
ifelse(
is.na(alcdays),
NA_integer_,
ifelse(alcdays == 0, 0L, 1L)
)
)
alcoholuse_new$drinkfreq <-
with(alcoholuse_new,
ifelse(is.na(alcdays), NA_integer_,
ifelse(alcdays == 0, 0L,
ifelse(alcdays <= 7, 1L, 2L))))
table(alcoholuse_new$drinker, alcoholuse_new$drinkfreq)
summary(alcoholuse_new)
View(alcoholuse_new)
alcoholuse_new$agetrycig <- round(alcoholuse_new$agetrycig,0)
alcoholuse_new$agetryalc <- round(alcoholuse_new$agetryalc,0)
alcoholuse_new$age <- round(alcoholuse_new$age,0)
summary(alcoholuse_new)
alcoholuse_new$cigdays <- ifelse(alcoholuse_new$cigdays > 30, 30, alcoholuse_new$cigdays)
summary(alcoholuse_new)
write.csv(alcoholuse_new, file = '~/desktop/Alcohol.csv', row.names = F)
