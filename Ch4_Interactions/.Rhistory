dat <- read.csv(data_url)
names(dat)[names(dat) == "y"] <- "y"
names(dat)[names(dat) == "x"]  <- "x"
names(dat)[names(dat) == "m1"]  <- "m1"
names(dat)[names(dat) == "m2"] <- "m2"
dat <- read.csv(data_url)
names(dat)[names(dat) == "workbeh"] <- "y"
names(dat)[names(dat) == "orgcon"]  <- "x"
names(dat)[names(dat) == "consci"]  <- "m1"
names(dat)[names(dat) == "emostab"] <- "m2"
dat$m1 <- ifelse(
is.na(dat$m1),
NA_integer_,
ifelse(dat$m1 > mean(dat$m1, na.rm = TRUE), 1L, 0L)
)
dat$m2 <- ifelse(
is.na(dat$m2),
NA_integer_,
ifelse(dat$m2 > mean(dat$m2, na.rm = TRUE), 1L, 0L)
)
mod1 <- rblimp(
data = dat,                              # R data frame
ordinal = 'm1 m2',
center = 'x',            # center predictors
model = '
y ~ x m1 m2
x*m1 x*m2 m1*m2
x*m1*m2;',                  # 2- and 3-way products
simple = 'x | m1 and m2',      # conditional effects
seed = 90291,                                # random number seed
burn = 10000,                                # warm-up iterations
iter = 10000)                                # analysis iterations
output(mod1)
mod1 <- rblimp(
data = dat,
ordinal = 'm1 m2',
center = 'x',
model = '
y ~ 1@b0 x@b1 m1@b2 m2@b3
x*m1@b4 x*m2@b5 m1*m2@b6 x*m1*m2@b7;',
parameters = '
xm1_at_m2_0 = b4;                    # x by m1 interaction at m2 = 0
xm1_at_m2_1 = b4 + b7;               # x by m1 interaction at m2 = 1
xm1_diff    = b7;',                  # difference in the two contrasts
simple = 'x | m1 and m2',              # simple simple effects of x
seed = 90291,
burn = 10000,
iter = 10000)
output(mod1)
simple_plot(y ~ x | m1 + m2, mod1)
